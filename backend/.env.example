# Local dev server port
PORT=3001

# Allowed frontend origins (comma separated). Use * during the hackathon.
CORS_ORIGIN=http://localhost:5173

# LLM used ONLY to rewrite the evidence in plain English (max 80 words).
# Any OpenAI-compatible Chat Completions API works (OpenAI, Groq, OpenRouter, ...).
# Leave LLM_API_KEY empty to always use the built-in templates.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=8000

# NASA POWER live climatology (GET /api/zones/:id/climate?live=true).
# Falls back to data/climate_summary.json if the request fails or is disabled.
NASA_POWER_LIVE=true
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
NASA_POWER_TIMEOUT_MS=8000

# NASA Earthdata login, only for `python scripts/preprocess/fetch_earthdata.py --search-granules`
# Create an account at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
